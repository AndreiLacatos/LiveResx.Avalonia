        <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\LiveResx.Avalonia\LiveResx.Avalonia.csproj" />
        <ProjectReference Include="..\..\..\src\LiveResx.Avalonia.SourceGenerators\LiveResx.Avalonia.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Translations\Translations.csproj" />
    </ItemGroup>

